---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}
const { entry } = Astro.props;
const d = entry.data;
const no = String(d.wpt).padStart(2, '0');
const href = d.links[0]?.href;
const Tag = href ? 'a' : 'div';
---

<article class="item" data-wpt={no}>
  <div class="mk">
    <i class="dia" aria-hidden="true"></i>
    <span class="mono no">WPT {no}</span>
  </div>

  <Tag
    class="row"
    href={href}
    target={href ? '_blank' : undefined}
    rel={href ? 'noopener' : undefined}
  >
    <div class="head">
      <h3 class="cond name">{d.title}</h3>
      <span class="badge" data-s={d.status}>{d.statusLabel}</span>
      <span class="mono meta">{d.subtitle} · {d.date}</span>
      {href && <span class="mono ext">{d.links[0].label} ↗</span>}
    </div>
    <p class="summary">{d.summary}</p>
    <ul class="tags">
      {d.tags.map((t) => <li class="mono">{t}</li>)}
    </ul>
  </Tag>
</article>

<style>
  .item {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    padding-block: clamp(1rem, 2.4vw, 1.5rem);
  }
  :global(html.js) .item {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22, 0.7, 0.3, 1);
  }
  :global(html.js) .item.in {
    opacity: 1;
    transform: none;
  }

  .mk {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.55rem;
  }
  .dia {
    width: 9px;
    height: 9px;
    border: 1.5px solid var(--fg-faint);
    transform: rotate(45deg);
    background: var(--bg);
    transition: border-color 0.35s, background 0.35s;
    z-index: 1;
  }
  .mk.lit .dia {
    border-color: var(--route);
    background: var(--bg);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--route) 14%, transparent);
  }
  .no {
    display: none;
  }

  .row {
    display: block;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1.1rem;
    transition: border-color 0.2s;
  }
  a.row:hover {
    border-color: var(--route);
  }
  .head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.55rem 0.9rem;
  }
  .name {
    margin: 0;
    font-size: 1.22rem;
    color: var(--fg);
    transition: color 0.2s;
  }
  a.row:hover .name {
    color: var(--route);
  }
  .meta,
  .ext {
    font-size: 0.58rem;
    color: var(--fg-faint);
  }
  .ext {
    margin-left: auto;
    color: var(--fg-dim);
  }
  .summary {
    margin: 0.6rem 0 0;
    font-size: 0.86rem;
    color: var(--fg-dim);
    max-width: 52em;
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0.7rem 0 0;
    padding: 0;
  }
  .tags li {
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: none;
    color: var(--fg-faint);
  }
  @media (max-width: 640px) {
    .ext {
      margin-left: 0;
    }
  }
</style>
