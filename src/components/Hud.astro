---
import { site } from '../data/site';

interface Props {
  waypoints: number;
}
const { waypoints } = Astro.props;

/** METAR 报文的时间戳格式：DDHHMMZ（UTC） */
const now = new Date();
const p = (n: number) => String(n).padStart(2, '0');
const stamp = `${p(now.getUTCDate())}${p(now.getUTCHours())}${p(now.getUTCMinutes())}Z`;

const chips = [
  { t: 'AdventureX 2026', s: '赛道一等奖' },
  { t: '豆包应用生成挑战赛', s: '全国金奖' },
  { t: 'Microsoft Terminal', s: 'PR MERGED' },
];
---

<section class="hud">
  <div class="wrap inner">
    <div class="left">
      <p class="mono eyebrow">
        {site.handle} · {site.name} · {site.age}
      </p>
      <h1>
        <span>能定义产品，</span>
        <span>也能自己把它写完。</span>
      </h1>
      <p class="lede">
        18 岁，做 AI 产品，也自己写代码把它做出来、部署上线、上台讲明白。
        下面是七个航路点——三个是我最想让你看的，四个是顺手做的。
        其中一个现在还不行，我把原因也写在里面了。
      </p>
      <ul class="chips">
        {
          chips.map((c) => (
            <li>
              <span class="ct">{c.t}</span>
              <span class="cs mono">{c.s}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="panel status" aria-label="当前状态">
      <p class="mono shead">STATUS · 实时状态</p>
      <pre class="metar"><code><span class="l l1">{site.callsign} {stamp} STATUS/AVAIL</span>
<span class="l l2">BUILD KINOLENS   VERDICT 2026-08-10</span>
<span class="l l3">RMK SEEKING REMOTE INTERNSHIP</span>
<span class="l l4">    AI PRODUCT / AGENT</span>
<span class="l l5">CTC {site.email}<b class="cur"></b></span></code></pre>
      <a class="cta" href={`mailto:${site.email}`}>
        <span>建立联系</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M4 12h15M13 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>
    </aside>
  </div>

  <div class="wrap strip">
    <p class="mono pos">POS 22.99N 113.75E · DONGGUAN</p>
    <a class="mono ahead" href="#work">
      {waypoints} WAYPOINTS AHEAD <span class="chev">↓</span>
    </a>
  </div>
</section>

<style>
  .hud {
    padding-top: clamp(3rem, 9vw, 6.5rem);
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .eyebrow {
    margin: 0 0 1.4rem;
    color: var(--route);
  }
  h1 {
    margin: 0;
    font-family: var(--font-cn);
    font-weight: 700;
    font-size: clamp(2.1rem, 6.2vw, 4.05rem);
    line-height: 1.16;
    letter-spacing: 0.005em;
  }
  h1 span {
    display: block;
  }
  h1 span:last-child {
    color: var(--fg-dim);
  }
  .lede {
    margin: 1.6rem 0 0;
    max-width: 34em;
    color: var(--fg-dim);
    font-size: 0.96rem;
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
  }
  .chips li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    border: 1px solid var(--rule);
    padding: 0.4rem 0.75rem;
    background: color-mix(in srgb, var(--bg-elev) 60%, transparent);
  }
  .ct {
    font-size: 0.8rem;
    color: var(--fg);
  }
  .cs {
    font-size: 0.6rem;
    color: var(--caution);
  }

  /* STATUS 面板 */
  .status {
    padding: 1.15rem 1.25rem 1.25rem;
  }
  .shead {
    margin: 0 0 0.9rem;
    color: var(--fg-faint);
    font-size: 0.62rem;
  }
  .metar {
    margin: 0;
    overflow-x: auto;
  }
  .metar code {
    font-family: var(--font-mono);
    font-size: clamp(0.63rem, 1.15vw, 0.74rem);
    line-height: 1.95;
    color: var(--normal);
    /* 各行本身是 block，父级不能再吃掉模板里的字面换行 */
    white-space: normal;
  }
  .l {
    display: block;
    white-space: pre;
    opacity: 0;
    animation: reveal 0.34s ease forwards;
  }
  .l1 {
    color: var(--fg);
    animation-delay: 0.15s;
  }
  .l2 {
    animation-delay: 0.45s;
  }
  .l3 {
    color: var(--caution);
    animation-delay: 0.75s;
  }
  .l4 {
    color: var(--caution);
    animation-delay: 0.95s;
  }
  .l5 {
    color: var(--fg-dim);
    animation-delay: 1.2s;
  }
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .cur {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.35em;
    background: var(--normal);
    vertical-align: -0.15em;
    animation: cursor 1.1s steps(1) infinite 1.5s;
  }
  @keyframes cursor {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.35rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--route);
    color: var(--route);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    transition: background 0.18s, color 0.18s;
  }
  .cta svg {
    width: 15px;
    height: 15px;
  }
  .cta:hover {
    background: var(--route);
    color: #fff;
  }

  /* 底部数据条 */
  .strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
  }
  .pos,
  .ahead {
    margin: 0;
    font-size: 0.62rem;
    color: var(--fg-faint);
  }
  .ahead {
    color: var(--fg-dim);
    transition: color 0.18s;
  }
  .ahead:hover {
    color: var(--route);
  }
  .chev {
    display: inline-block;
    animation: bob 2.4s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
    }
    .status {
      max-width: 100%;
    }
  }
  @media (max-width: 460px) {
    .pos {
      display: none;
    }
    .strip {
      justify-content: flex-end;
    }
  }
</style>
