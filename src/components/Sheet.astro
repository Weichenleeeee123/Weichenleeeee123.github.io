---
/* 纸面印刷底纹：罗盘玫瑰（带可转动的指针）、航路、图廓角标、纸纹。 */
const rose = Array.from({ length: 36 }, (_, i) => i * 10);
const cardinal = [
  { deg: 0, t: 'N' },
  { deg: 90, t: 'E' },
  { deg: 180, t: 'S' },
  { deg: 270, t: 'W' },
];
---

<div class="plate" aria-hidden="true">
  <span class="corner tl"></span>
  <span class="corner tr"></span>
  <span class="corner bl"></span>
  <span class="corner br"></span>

  <svg class="rose" viewBox="0 0 320 320" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="1">
      <circle cx="160" cy="160" r="58"></circle>
      <circle cx="160" cy="160" r="126"></circle>
      <circle cx="160" cy="160" r="148" stroke-dasharray="2 6"></circle>
    </g>
    <g stroke="currentColor" stroke-width="1">
      {
        rose.map((deg) => {
          const major = deg % 30 === 0;
          const rad = ((deg - 90) * Math.PI) / 180;
          const r1 = major ? 110 : 119;
          return (
            <line
              x1={160 + r1 * Math.cos(rad)}
              y1={160 + r1 * Math.sin(rad)}
              x2={160 + 126 * Math.cos(rad)}
              y2={160 + 126 * Math.sin(rad)}
            />
          );
        })
      }
    </g>
    <g class="rose-cardinal" fill="currentColor" font-size="13" font-family="var(--cond)" text-anchor="middle">
      {
        cardinal.map(({ deg, t }) => {
          const rad = ((deg - 90) * Math.PI) / 180;
          return (
            <text x={160 + 96 * Math.cos(rad)} y={160 + 96 * Math.sin(rad) + 5}>
              {t}
            </text>
          );
        })
      }
    </g>
    {/* 指针：随当前所在区块转向 */}
    <g class="needle">
      <line x1="160" y1="160" x2="160" y2="46" stroke="currentColor" stroke-width="1.5"></line>
      <path d="M160 34 L166 52 L160 47 L154 52 Z" fill="currentColor"></path>
      <circle cx="160" cy="160" r="3.5" fill="currentColor"></circle>
    </g>
  </svg>

  <svg class="airways" viewBox="0 0 1000 1400" preserveAspectRatio="none" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="10 8">
      <path d="M-40 250 L1040 690"></path>
      <path d="M-40 1180 L1040 470"></path>
    </g>
  </svg>
</div>
