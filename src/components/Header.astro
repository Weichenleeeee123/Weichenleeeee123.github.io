---
import { site, nav } from '../data/site';
---

<header class="hdr">
  <div class="wrap bar">
    <a href="/" class="ident" aria-label="回到首页">
      <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
        <path
          d="M16 5 L27 27 L16 21 L5 27 Z"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linejoin="round"></path>
      </svg>
      <span class="callsign">{site.callsign}</span>
      <span class="fltplan" aria-hidden="true">
        {site.route.from}<span class="arrow">→</span>{site.route.to}
      </span>
    </a>
    <nav aria-label="主导航">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 52px;
  }
  .ident {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--route);
  }
  .mark {
    width: 17px;
    height: 17px;
    flex: none;
  }
  .callsign,
  .fltplan {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
  }
  .callsign {
    color: var(--fg);
  }
  .fltplan {
    color: var(--fg-faint);
  }
  .arrow {
    color: var(--route);
    padding-inline: 0.35em;
  }
  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
  }
  nav a {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--fg-dim);
    transition: color 0.18s;
  }
  nav a:hover {
    color: var(--route);
  }
  @media (max-width: 520px) {
    .fltplan {
      display: none;
    }
  }
</style>
