---
/* 每个作品的视觉封面：用它自己的方位/距离/代号生成一张进近图残片。
   七个参数各不相同，所以七张图各不相同，而且都不是随机的。 */
interface Props {
  brg: number;
  dist: number;
  code: string;
  active?: boolean;
  big?: boolean;
}
const { brg, dist, code, active = false, big = false } = Astro.props;

const W = 400;
const H = big ? 260 : 200;
const cx = W * 0.5;
const cy = H * 0.55;
const rad = ((brg - 90) * Math.PI) / 180;

/* 跑道条：以该项目的方位为角度穿过画面 */
const L = W * 0.85;
const x1 = +(cx - (L / 2) * Math.cos(rad)).toFixed(1);
const y1 = +(cy - (L / 2) * Math.sin(rad)).toFixed(1);
const x2 = +(cx + (L / 2) * Math.cos(rad)).toFixed(1);
const y2 = +(cy + (L / 2) * Math.sin(rad)).toFixed(1);

/* 距离弧：条数由 dist 决定 */
const arcs = Array.from({ length: Math.round(2 + dist * 3) }, (_, i) => 26 + i * 22);
const ticks = Array.from({ length: 8 }, (_, i) => i * 45);
---

<svg class="cover" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" preserveAspectRatio="xMidYMid slice">
  <g class="cv-arcs" fill="none" stroke="currentColor">
    {arcs.map((r) => <circle cx={cx} cy={cy} r={r} />)}
  </g>

  <g class="cv-ticks" stroke="currentColor">
    {
      ticks.map((d) => {
        const t = ((d - 90) * Math.PI) / 180;
        const r0 = arcs[arcs.length - 1] + 8;
        return (
          <line
            x1={cx + r0 * Math.cos(t)}
            y1={cy + r0 * Math.sin(t)}
            x2={cx + (r0 + 9) * Math.cos(t)}
            y2={cy + (r0 + 9) * Math.sin(t)}
          />
        );
      })
    }
  </g>

  <line class="cv-track" x1={x1} y1={y1} x2={x2} y2={y2}></line>
  <line class="cv-track-dash" x1={x1} y1={y1} x2={x2} y2={y2}></line>

  <g class={`cv-node${active ? ' on' : ''}`}>
    <circle cx={cx} cy={cy} r="5.5"></circle>
  </g>

  <text class="cv-code" x="16" y={H - 16}>{code}</text>
  <text class="cv-brg" x={W - 16} y={H - 16} text-anchor="end">{String(brg).padStart(3, '0')}°</text>
</svg>
