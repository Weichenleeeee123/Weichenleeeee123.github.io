---
/* 航图上的距离环。纯装饰，当作纸面印刷底纹，不参与信息传达。 */
const ticks = Array.from({ length: 24 }, (_, i) => i * 15);
---

<svg class="rings" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
  <g fill="none" stroke="#c9c2ae" stroke-width="1">
    <circle cx="200" cy="200" r="60" />
    <circle cx="200" cy="200" r="110" />
    <circle cx="200" cy="200" r="160" stroke-dasharray="3 5" />
    <circle cx="200" cy="200" r="196" />
  </g>
  <g stroke="#c9c2ae" stroke-width="1">
    {
      ticks.map((deg) => {
        const long = deg % 45 === 0;
        const r1 = long ? 182 : 189;
        const rad = ((deg - 90) * Math.PI) / 180;
        return (
          <line
            x1={200 + r1 * Math.cos(rad)}
            y1={200 + r1 * Math.sin(rad)}
            x2={200 + 196 * Math.cos(rad)}
            y2={200 + 196 * Math.sin(rad)}
          />
        );
      })
    }
  </g>
  <g stroke="#c9c2ae" stroke-width="1">
    <line x1="200" y1="4" x2="200" y2="34" />
    <line x1="200" y1="366" x2="200" y2="396" />
    <line x1="4" y1="200" x2="34" y2="200" />
    <line x1="366" y1="200" x2="396" y2="200" />
  </g>
</svg>
