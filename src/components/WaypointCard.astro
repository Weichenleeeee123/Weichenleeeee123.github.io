---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}
const { entry } = Astro.props;
const d = entry.data;
const no = String(d.wpt).padStart(2, '0');
---

<article class="item" data-wpt={no}>
  <div class="mk">
    <i class="dia" aria-hidden="true"></i>
    <span class="mono no">WPT {no}</span>
  </div>

  <div class="card panel">
    <header class="top">
      <div>
        <h3 class="cond name">{d.title}</h3>
        <p class="mono sub">{d.subtitle} · {d.date}</p>
      </div>
      <span class="badge" data-s={d.status}>{d.statusLabel}</span>
    </header>

    <p class="mono role">{d.role}</p>
    <p class="summary">{d.summary}</p>

    {
      d.metrics.length > 0 && (
        <dl class="metrics">
          {d.metrics.map((m) => (
            <div>
              <dt class="mono">{m.k}</dt>
              <dd class="cond">{m.v}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      d.quote && (
        <blockquote class="quote">
          <p>{d.quote.text}</p>
          <cite class="mono">— {d.quote.by}</cite>
        </blockquote>
      )
    }

    <ul class="tags">
      {d.tags.map((t) => <li class="mono">{t}</li>)}
    </ul>

    <div class="acts">
      {d.detail && <a class="go" href={`/work/${entry.id}`}>读完整篇 →</a>}
      {
        d.links.map((l) => (
          <a class="link" href={l.href} target="_blank" rel="noopener">
            {l.label} ↗
          </a>
        ))
      }
    </div>
  </div>
</article>

<style>
  .item {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    padding-block: clamp(1.6rem, 4vw, 2.6rem);
  }
  :global(html.js) .item {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 0.7, 0.3, 1);
  }
  :global(html.js) .item.in {
    opacity: 1;
    transform: none;
  }

  .mk {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.35rem;
  }
  .dia {
    width: 13px;
    height: 13px;
    border: 1.5px solid var(--fg-faint);
    transform: rotate(45deg);
    background: var(--bg);
    transition: border-color 0.35s, background 0.35s, box-shadow 0.35s;
    z-index: 1;
  }
  .mk.lit .dia {
    border-color: var(--route);
    background: var(--route);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--route) 18%, transparent);
  }
  .no {
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    writing-mode: vertical-rl;
    color: var(--fg-faint);
    transition: color 0.35s;
  }
  .mk.lit .no {
    color: var(--route);
  }

  .card {
    padding: clamp(1.15rem, 3vw, 1.85rem);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  .name {
    margin: 0;
    font-size: clamp(1.55rem, 4.2vw, 2.35rem);
    color: var(--fg);
  }
  .sub {
    margin: 0.45rem 0 0;
    font-size: 0.63rem;
    color: var(--fg-faint);
  }
  .role {
    margin: 1.1rem 0 0;
    font-size: 0.66rem;
    color: var(--caution);
    text-transform: none;
    letter-spacing: 0.06em;
  }
  .summary {
    margin: 0.85rem 0 0;
    color: var(--fg-dim);
    font-size: 0.94rem;
    max-width: 46em;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(115px, 1fr));
    gap: 1px;
    margin: 1.5rem 0 0;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .metrics > div {
    background: var(--bg);
    padding: 0.7rem 0.85rem;
  }
  .metrics dt {
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
    text-transform: none;
  }
  .metrics dd {
    margin: 0.35rem 0 0;
    font-size: 1.3rem;
    color: var(--fg);
    letter-spacing: 0.02em;
  }

  .quote {
    margin: 1.5rem 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--route);
  }
  .quote p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--fg);
  }
  .quote cite {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.6rem;
    font-style: normal;
    color: var(--fg-faint);
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.4rem 0 0;
    padding: 0;
  }
  .tags li {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: none;
    color: var(--fg-dim);
    border: 1px solid var(--rule);
    padding: 0.22em 0.55em;
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.4rem;
    margin-top: 1.6rem;
  }
  .go {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--route);
    border-bottom: 1px solid var(--route);
    padding-bottom: 2px;
  }
  .go:hover {
    color: var(--fg);
    border-color: var(--fg);
  }

  @media (max-width: 640px) {
    .no {
      display: none;
    }
    .top {
      flex-direction: column;
      gap: 0.7rem;
    }
  }
</style>
