---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import avatar from '../assets/avatar.jpg';
import type { ImageMetadata } from 'astro';
import { site, profile, stats, projects, alternates, logbook, checklist, radio } from '../data/site';
import '../styles/studio.css';

/* 房间里每样东西对应一块内容；顺序就是底部导航的顺序 */
const spots = [
  { id: 'works', thing: '显示器', label: '作品' },
  { id: 'journey', thing: '软木板', label: '经历' },
  { id: 'shelf', thing: '书架', label: '小玩意' },
  { id: 'skills', thing: '白板', label: '技能' },
  { id: 'about', thing: '海报', label: '关于我' },
  { id: 'contact', thing: '手机', label: '联系' },
];

/* 显示器和海报上的贴图用小尺寸 webp，原图有好几 MB */
const small = async (img: ImageMetadata | undefined, width: number) => (img ? (await getImage({ src: img, width, format: 'webp' })).src : '');
const covers = await Promise.all(projects.map((p) => small(p.image, 640)));

const roomData = {
  projects: projects.map((p, i) => ({ code: p.code, name: p.name, sub: p.sub, when: p.when, award: p.award ?? '', image: covers[i] })),
  books: alternates.map((a) => a.name),
  pins: logbook.map((l) => ({ date: l.date, stamp: l.stamp ?? '' })),
  skills: checklist.map((c) => c.item),
  name: site.name,
  callsign: site.callsign,
  nameEn: site.nameEn,
  avatar: await small(avatar, 320),
  motto: site.motto,
  spots,
};
---

<Base title="围城的房间" themeColor="#17120e">
  <div class="studio" data-studio>
    <canvas class="room" data-room aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>

    <header class="st-top">
      <a class="st-brand" href="#about" data-open="about">
        <Image src={avatar} alt="" width={64} height={64} class="st-avatar" />
        <span>{site.name}<i>· {site.callsign}的房间</i></span>
      </a>
      <div class="st-actions">
        <button type="button" class="st-pill" data-list aria-pressed="false" title="不转房间，直接看全部内容">直接看</button>
        <button type="button" class="st-pill" data-light aria-pressed="true" title="开关台灯">台灯</button>
        <button type="button" class="st-pill" data-sound aria-pressed="true" title="开关音效">声音 开</button>
        <a class="st-pill st-fly" href="/cockpit/" data-style-switch="cockpit" title="换一种风格：737 驾驶舱">
          <svg viewBox="-12 -12 24 24" aria-hidden="true"><path d="M0 -10 L2 -3 L10 2 L10 4 L2 2 L1.5 7 L4 9 L4 10.5 L0 9.5 L-4 10.5 L-4 9 L-1.5 7 L-2 2 L-10 4 L-10 2 L-2 -3 Z" /></svg>
          去驾驶舱
        </a>
      </div>
    </header>

    <div class="st-hero" data-hero>
      <p class="st-kicker">NANJING · <span data-clock>--:--</span> · <span data-sky-label>夜里</span></p>
      <h1 class="st-title" data-title>
        {[...site.name].map((c, i) => <span style={`--i:${i}`}>{c}</span>)}
      </h1>
      <p class="st-en">{site.nameEn} · {site.callsign}</p>
      <p class="st-motto">{site.motto}</p>
      <p class="st-hint"><span class="st-hint-dot"></span><span data-hint>拖动转一转 · 点房间里的东西</span></p>
    </div>

    <nav class="st-dock" aria-label="房间里的东西">
      {
        spots.map((s, i) => (
          <button type="button" data-open={s.id} style={`--i:${i}`}>
            <b>{s.label}</b>
            <span>{s.thing}</span>
          </button>
        ))
      }
    </nav>

    <div class="st-tip" data-tip aria-hidden="true"></div>
    <div class="st-bubble" data-bubble aria-hidden="true"></div>

    <div class="st-loader" data-loader aria-hidden="true">
      <p>正在开灯<span data-load-dots>…</span></p>
      <i><b data-load-bar></b></i>
    </div>

    <aside class="st-drawer" data-drawer aria-label="内容">
      <div class="st-grab" data-grab aria-hidden="true"><i></i></div>
      <button type="button" class="st-close" data-close aria-label="关上，回到房间">
        <span>回到房间</span><kbd>Esc</kbd>
      </button>

      <div class="st-doc">
        <header class="doc-head">
          <Image src={avatar} alt="围城的头像：一只可达鸭" width={120} height={120} class="doc-avatar" />
          <div>
            <h2>{site.name} · {site.callsign}</h2>
            <p>{site.motto}</p>
          </div>
        </header>

        <!-- ───── 显示器 · 作品 ───── -->
        <section class="panel p-works" id="works" data-panel="works">
          <p class="p-kicker">显示器 · {projects.length} 个作品</p>
          <h2 class="p-title">做过的东西</h2>
          <div class="works-tabs" role="tablist" aria-label="作品">
            {
              projects.map((p, i) => (
                <button type="button" role="tab" data-work-tab={i} aria-selected={i === 0 ? 'true' : 'false'}>
                  <span>{String(i + 1).padStart(2, '0')}</span>
                  {p.name}
                </button>
              ))
            }
          </div>
          <div class="works-list">
            {
              projects.map((p, i) => (
                <article class:list={['work', i === 0 && 'on']} data-work={i}>
                  {p.image && (
                    <div class="work-shot">
                      <Image src={p.image} alt={`${p.name} 截图`} widths={[480, 960]} sizes="(max-width: 760px) 92vw, 560px" loading="lazy" />
                    </div>
                  )}
                  <div class="work-meta">
                    <span class="work-when">{p.when}</span>
                    <span class="work-code">{p.code}</span>
                  </div>
                  <h3>{p.name}</h3>
                  <p class="work-sub">{p.sub}</p>
                  {p.award && <p class="work-award">{p.award}</p>}
                  <p class="work-desc">{p.desc}</p>
                  <p class="work-stack">
                    {p.stack}
                    {p.role && <span> · {p.role}</span>}
                  </p>
                  {p.links.length > 0 && (
                    <p class="work-links">
                      {p.links.map((l) => (
                        <a href={l.href} target="_blank" rel="noopener">
                          {l.text} ↗
                        </a>
                      ))}
                    </p>
                  )}
                </article>
              ))
            }
          </div>
          <div class="works-nav">
            <button type="button" data-work-step="-1" aria-label="上一个">←</button>
            <span data-work-count>01 / {String(projects.length).padStart(2, '0')}</span>
            <button type="button" data-work-step="1" aria-label="下一个">→</button>
          </div>
          <button type="button" class="p-next" data-open={spots[1].id}>
            <span>下一样 · {spots[1].thing}</span>
            <b>{spots[1].label} →</b>
          </button>
        </section>

        <!-- ───── 软木板 · 经历 ───── -->
        <section class="panel p-journey" id="journey" data-panel="journey">
          <p class="p-kicker">软木板 · 钉着的票根</p>
          <h2 class="p-title">一路走过来的</h2>
          <ol class="pins">
            {
              logbook.map((l, i) => (
                <li style={`--r:${((i * 37) % 7) - 3}deg`}>
                  <span class="pin-dot" aria-hidden="true" />
                  <time>{l.date}</time>
                  <p>{l.remark}</p>
                  <span class="pin-route">
                    {l.from} → {l.to}
                  </span>
                  {l.stamp && <span class="pin-stamp">{l.stamp}</span>}
                </li>
              ))
            }
          </ol>
          <button type="button" class="p-next" data-open={spots[2].id}>
            <span>下一样 · {spots[2].thing}</span>
            <b>{spots[2].label} →</b>
          </button>
        </section>

        <!-- ───── 书架 · 小玩意 ───── -->
        <section class="panel p-shelf" id="shelf" data-panel="shelf">
          <p class="p-kicker">书架 · 没单独展开的</p>
          <h2 class="p-title">顺手做的小玩意</h2>
          <ul class="books">
            {
              alternates.map((a, i) => (
                <li style={`--h:${(i * 47) % 360}`}>
                  <a href={a.href} target="_blank" rel="noopener">
                    <b>{a.name}</b>
                    <span>{a.note}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <button type="button" class="p-next" data-open={spots[3].id}>
            <span>下一样 · {spots[3].thing}</span>
            <b>{spots[3].label} →</b>
          </button>
        </section>

        <!-- ───── 白板 · 技能 ───── -->
        <section class="panel p-skills" id="skills" data-panel="skills">
          <p class="p-kicker">白板 · 会的东西</p>
          <h2 class="p-title">手上的家伙</h2>
          <ul class="board">
            {
              checklist.map((c) => (
                <li>
                  <span class="tick" aria-hidden="true" />
                  {c.item}
                  {c.state !== 'CHECKED' && <small>{c.state}</small>}
                </li>
              ))
            }
          </ul>
          <ul class="tally">
            {
              stats.map((s) => (
                <li>
                  <b>
                    {s.value}
                    {s.suffix}
                  </b>
                  <span>{s.label.replace(/^个/, '')}</span>
                </li>
              ))
            }
          </ul>
          <button type="button" class="p-next" data-open={spots[4].id}>
            <span>下一样 · {spots[4].thing}</span>
            <b>{spots[4].label} →</b>
          </button>
        </section>

        <!-- ───── 海报 · 关于我 ───── -->
        <section class="panel p-about" id="about" data-panel="about">
          <p class="p-kicker">墙上的海报 · 关于我</p>
          <div class="poster">
            <Image src={avatar} alt="围城的头像：一只可达鸭" width={360} height={360} class="poster-img" />
            <h2 class="poster-name">{site.name}</h2>
            <p class="poster-en">{site.nameEn} · 花名 {site.callsign}</p>
            <dl>
              <dt>现在</dt><dd>{profile.school}</dd>
              <dt>在做</dt><dd>{profile.ratings}</dd>
              <dt>老家</dt><dd>{profile.home}</dd>
            </dl>
            <p class="poster-motto">「{site.motto}」</p>
            <ul class="poster-tags">
              {profile.hobbies.map((h) => <li>{h}</li>)}
            </ul>
          </div>
          <button type="button" class="p-next" data-open={spots[5].id}>
            <span>下一样 · {spots[5].thing}</span>
            <b>{spots[5].label} →</b>
          </button>
        </section>

        <!-- ───── 手机 · 联系 ───── -->
        <section class="panel p-contact" id="contact" data-panel="contact">
          <p class="p-kicker">桌上的手机 · 联系我</p>
          <h2 class="p-title">找我聊聊</h2>
          <ul class="phone">
            {
              radio.map((r) => (
                <li>
                  {r.href ? (
                    <a href={r.href} target={r.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                      <span class="ph-icon" aria-hidden="true">{r.label.slice(0, 1)}</span>
                      <span class="ph-label">{r.label}</span>
                      <span class="ph-value">{r.value}</span>
                    </a>
                  ) : (
                    <div>
                      <span class="ph-icon" aria-hidden="true">{r.label.slice(0, 1)}</span>
                      <span class="ph-label">{r.label}</span>
                      <span class="ph-value">{r.value}</span>
                    </div>
                  )}
                </li>
              ))
            }
          </ul>
          <button type="button" class="p-next" data-open={spots[0].id}>
            <span>下一样 · {spots[0].thing}</span>
            <b>{spots[0].label} →</b>
          </button>
        </section>

        <footer class="doc-foot">
          <p>房间里的一切都是代码实时搭出来的，没有用一个现成模型。</p>
          <p>© 2026 {site.name} · <a href="/cockpit/" data-style-switch="cockpit">换成 737 驾驶舱风格 ✈</a></p>
        </footer>
      </div>
    </aside>
  </div>

  <script type="application/json" id="room-data" set:html={JSON.stringify(roomData)} />
  <script>
    import '../scripts/studio/main';
    import '../scripts/style-pref';
  </script>
</Base>
