---
import Base from '../layouts/Base.astro';
import Cockpit from '../components/Cockpit.astro';
---

<Base>
  <!--
    首页有两种风格：驾驶舱（就是这一页）和「围城的房间」（/studio/）。
    第一次来随机抽一种并记在本地，之后一直是这一种；页面角上可以换。
    想指定给别人看哪种，就发 /cockpit/ 或 /studio/。
    搜索引擎和打不开 localStorage 的情况留在这一页，不跳转。
  -->
  <script is:inline slot="head">
    (function () {
      if (/bot|crawl|spider|slurp|preview|facebookexternalhit/i.test(navigator.userAgent)) return;
      var KEY = 'wc-style';
      var s;
      try {
        s = localStorage.getItem(KEY);
        if (s !== 'cockpit' && s !== 'studio') {
          var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
          s = calm || Math.random() < 0.5 ? 'studio' : 'cockpit';
          localStorage.setItem(KEY, s);
        }
      } catch (e) {
        return;
      }
      if (s === 'studio') {
        document.documentElement.style.visibility = 'hidden';
        location.replace('/studio/' + location.hash);
      }
    })();
  </script>
  <Cockpit />
</Base>
