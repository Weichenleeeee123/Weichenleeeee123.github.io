---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';
import { links, site } from '../data/site';
import ChartMap from '../components/ChartMap.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

/* 航图表头那种生效日期 + 报文时间戳，随每次构建更新 */
const now = new Date();
const p2 = (n: number) => String(n).padStart(2, '0');
const stamp = `${p2(now.getUTCDate())}${p2(now.getUTCHours())}${p2(now.getUTCMinutes())}Z`;
const eff = now
  .toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
  .toUpperCase();

const status = [
  { k: '在做', v: 'KinoLens，重写它的剪辑决策层' },
  { k: '在找', v: 'AI 产品方向的远程实习', amber: true },
  { k: '在学', v: '多智能体编排，以及怎么把话说清楚' },
];
---

<Base>
  <header class="titleblock">
    <div class="tb-strip">
      <span>个人主页 · PERSONAL CHART</span>
      <span class="right">
        <span data-bearing-readout>HDG 000°</span>
        <span>{site.callsign} · <span data-zulu>{stamp}</span></span>
        <button class="mode" type="button" data-theme-toggle>DAY</button>
      </span>
    </div>

    <div class="tb-main">
      <div class="tb-copy">
        <h1>围城<span class="en">Weichen Li</span></h1>
        <p class="tagline" data-reveal style="--delay:420ms">
          18 岁，做 AI 产品。能定义产品，也能自己把它写完。
        </p>
      </div>
      <ChartMap />
    </div>

    <div class="tb-data">
      {
        status.map((s, i) => (
          <div class="cell" data-reveal style={`--delay:${140 + i * 70}ms`}>
            <span class="k">{s.k}</span>
            <span class={`v${s.amber ? ' amber' : ''}`}>{s.v}</span>
          </div>
        ))
      }
    </div>

    <div class="stats">
      {
        [
          { n: '7', l: '个做完并交付的作品' },
          { n: '2', l: '个全国级奖项' },
          { n: '1', l: '个合并进微软主线的 PR' },
          { n: '6', u: '年', l: '模拟飞行 · 写日记' },
        ].map((s) => (
          <div class="s">
            <span class="n">
              {s.n}
              {s.u && <em>{s.u}</em>}
            </span>
            <span class="l">{s.l}</span>
          </div>
        ))
      }
    </div>

    <ul class="tb-links">
      {
        links.map((l) => (
          <li>
            {l.href ? (
              <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>
                {l.text}
              </a>
            ) : (
              <span class="plain">{l.text}</span>
            )}
          </li>
        ))
      }
    </ul>
  </header>

  <section class="block" data-bearing="30">
    <h2><span class="num">01</span>关于</h2>
    <div class="body bio">
      <p>
        我习惯一个人把全程跑完：定义问题、写代码、部署上线、上台把它讲明白。做过的东西里，有拿奖的，也有到现在还不行的——两种我都放在下面了。
      </p>
      <p>玩了六年模拟飞行，写了六年日记。这个站用来放作品和一些复盘，写得不勤，但写的都是真做过的事。</p>
    </div>
  </section>

  <section class="block" data-bearing="135">
    <h2><span class="num">02</span>作品</h2>
    <div class="body">
      <ol class="route">
        <span class="route-progress" aria-hidden="true" />
        {
          projects.map((p, i) => (
            <li class={`wpt${p.active ? ' active' : ''}`} id={`wpt-${i}`} data-wpt={i}>
              <span class="pt" />
              <div class="card" data-reveal>
                <span class="idx">WPT {String(i + 1).padStart(2, '0')}</span>
                <h3>
                  {p.href ? (
                    <a href={p.href} target="_blank" rel="noopener">
                      {p.name}
                    </a>
                  ) : (
                    p.name
                  )}
                  <span class="sub"> — {p.sub}</span>
                </h3>
                <p>{p.desc}</p>
                <div class="meta">
                  {p.tags.map((t) => (
                    <span class={`tag${t.kind ? ' ' + t.kind : ''}`}>{t.text}</span>
                  ))}
                  {p.hrefText && <span>{p.hrefText}</span>}
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="block" data-bearing="255">
    <h2><span class="num">03</span>文章</h2>
    <div class="body">
      {
        posts.length === 0 ? (
          <p class="empty">还没有。</p>
        ) : (
          <ul class="posts">
            {posts.map((post) => (
              <li data-reveal>
                <span class="d">{fmt(post.data.date)}</span>
                <a class="t" href={`/log/${post.id}/`}>
                  {post.data.title}
                </a>
                <p class="s">{post.data.summary}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <div class="tb-strip" style="border-top:1px solid var(--rule); border-bottom:0; position:relative; z-index:1;">
    <span>EFF {eff}</span>
    <span>END OF CHART</span>
  </div>
</Base>
