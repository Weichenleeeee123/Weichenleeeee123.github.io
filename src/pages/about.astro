---
import Base from '../layouts/Base.astro';
import '../styles/prose.css';
import { site, links } from '../data/site';

const timeline = [
  { t: '2020', v: '开始玩模拟飞行，X-Plane 和 MSFS，在 VATSIM 上连飞。最爱波音 737。' },
  { t: '2026-02', v: 'Virtual ATC：一天写完 95% 核心功能的 AI 管制员。' },
  { t: '2026-04', v: '语文老师.skill 开源，AI 高考作文教练。' },
  { t: '2026-06', v: '高考。结果不好，写在下面了。' },
  { t: '2026-07', v: 'AdventureX 2026，人生第一次线下黑客松，拿了赛道一等奖。' },
  { t: '2026-09', v: '航线转场：广东 → 南京。' },
];
---

<Base title="ABOUT" description="围城 Weichen Li，18 岁，AI 产品人 / 独立开发者。">
  <div class="wrap page">
    <header class="hd">
      <p class="mono eyebrow">{site.handle} · {site.name} · {site.age}</p>
      <h1 class="cond">ABOUT</h1>
    </header>

    <div class="cols">
      <div class="prose">
        <p>
          我叫围城，实名李伟宸，18 岁。做 AI 产品，也自己写代码把它做出来。
        </p>
        <p>
          我干活的方式基本是一个人从头跑到尾：定义问题、画产品、写代码、部署上线、最后自己上台把它讲明白。
          <strong>不是提完需求等排期的那种产品经理。</strong>
          AdventureX 2026 拿一等奖那次，全队 147 次提交我占了 91 次，同时也是上台 Pitch 的人——
          这两件事在我这儿从来不分家。
        </p>

        <h2>我现在关心什么</h2>
        <p>
          多智能体怎么才能真的可用而不只是能跑通 Demo：Agent 之间怎么交接、怎么防止模型把不知道的东西编圆、
          怎么让整条链路可审计。以及一个更笨的问题——
          <strong>AI 到底能不能替人做「创作决策」</strong>，比如决定一条视频从哪儿切。
          KinoLens 做了半年就是在问这个，目前的答案是"还没证明"。
        </p>

        <h2>关于那场考试</h2>
        <p>
          2026 年高考我考砸了，比自己预估低了约 50 分。当时确实哭了一场，也认真想过复读。
          最后没复读，因为想明白一件事：一次考试不改变能力水平，把能力做到最好比学校的 title 更重要。
          这页上的东西大部分是在备考那一年的缝隙里做的。
        </p>

        <h2>不写代码的时候</h2>
        <p>
          飞模拟飞行（2020 年至今，737 + PMDG）、跑 5 公里、写了六年日记、打杀戮尖塔。
          用大疆拍东西——那近 1TB 素材就是 KinoLens 存在的原因。
        </p>

        <h2>找我</h2>
        <p>
          我在找 AI 产品方向的远程实习或合作，也想认识做 AI 产品和 Agent 的人。
          邮件是最靠谱的入口，我会回。
        </p>
      </div>

      <aside class="side">
        <div class="panel box">
          <p class="mono lbl">CONTACT</p>
          <ul class="ct">
            {
              links.map((l) => (
                <li>
                  <span class="mono k">{l.label}</span>
                  <a class="link" href={l.href} target="_blank" rel="me noopener">
                    {l.value}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <p class="mono lbl tl-lbl">FLIGHT LOG</p>
        <ol class="tl">
          {
            timeline.map((x) => (
              <li>
                <span class="mono y">{x.t}</span>
                <span class="v">{x.v}</span>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(2rem, 6vw, 3.5rem);
  }
  .hd {
    padding-bottom: clamp(1.4rem, 4vw, 2.2rem);
    border-bottom: 1px solid var(--rule);
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .eyebrow {
    margin: 0 0 0.9rem;
    color: var(--route);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 9vw, 5rem);
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(250px, 0.8fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }
  .box {
    padding: 1.15rem 1.25rem 1.3rem;
  }
  .lbl {
    margin: 0 0 0.9rem;
    font-size: 0.6rem;
    color: var(--fg-faint);
  }
  .ct {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .ct li {
    display: grid;
    gap: 0.15rem;
  }
  .k {
    font-size: 0.55rem;
    color: var(--fg-faint);
  }
  .tl-lbl {
    margin-top: 2.2rem;
  }
  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px dashed var(--rule);
  }
  .tl li {
    position: relative;
    padding: 0 0 1.15rem 1.1rem;
  }
  .tl li::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.5em;
    width: 7px;
    height: 7px;
    background: var(--bg);
    border: 1px solid var(--route);
    transform: rotate(45deg);
  }
  .y {
    display: block;
    font-size: 0.58rem;
    color: var(--route);
  }
  .v {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.83rem;
    line-height: 1.65;
    color: var(--fg-dim);
  }
  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
