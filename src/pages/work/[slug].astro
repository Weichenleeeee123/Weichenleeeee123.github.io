---
import Base from '../../layouts/Base.astro';
import '../../styles/prose.css';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => data.detail);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const no = String(d.wpt).padStart(2, '0');
---

<Base title={d.title} description={d.summary}>
  <article class="wrap page">
    <p class="mono crumb">
      <a href="/#work">WORK</a> / WPT {no}
    </p>

    <header class="hd">
      <div class="row">
        <h1 class="cond">{d.title}</h1>
        <span class="badge" data-s={d.status}>{d.statusLabel}</span>
      </div>
      <p class="mono sub">{d.subtitle} · {d.date} · {d.role}</p>
      <p class="lede">{d.summary}</p>

      {
        d.metrics.length > 0 && (
          <dl class="metrics">
            {d.metrics.map((m) => (
              <div>
                <dt class="mono">{m.k}</dt>
                <dd class="cond">{m.v}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        d.links.length > 0 && (
          <div class="acts">
            {d.links.map((l) => (
              <a class="link" href={l.href} target="_blank" rel="noopener">
                {l.label} ↗
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="back">
      <a class="link" href="/#work">← 回到航线</a>
    </nav>
  </article>
</Base>

<style>
  .page {
    padding-top: clamp(2rem, 6vw, 3.5rem);
  }
  .crumb {
    margin: 0 0 2rem;
    font-size: 0.62rem;
    color: var(--fg-faint);
  }
  .crumb a:hover {
    color: var(--route);
  }
  .hd {
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--rule);
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.3rem, 7vw, 4rem);
  }
  .sub {
    margin: 0.7rem 0 0;
    font-size: 0.63rem;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.1em;
  }
  .lede {
    margin: 1.5rem 0 0;
    max-width: 42em;
    color: var(--fg-dim);
    font-size: 1rem;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1px;
    margin: 2rem 0 0;
    background: var(--rule);
    border: 1px solid var(--rule);
    max-width: 46em;
  }
  .metrics > div {
    background: var(--bg);
    padding: 0.75rem 0.9rem;
  }
  .metrics dt {
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
    text-transform: none;
  }
  .metrics dd {
    margin: 0.35rem 0 0;
    font-size: 1.35rem;
    color: var(--fg);
  }
  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 1.8rem;
  }
  .back {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
</style>
