---
import '../styles/global.css';
import { site } from '../data/site';
import Rings from '../components/Rings.astro';

interface Props {
  title?: string;
  description?: string;
  /** 文章页把距离环去掉，别跟正文抢注意力 */
  rings?: boolean;
}

const { title, description = site.description, rings = true } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f5f2ea" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono-var.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/barlow-condensed-600.woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
  </head>
  <body>
    <div class="shell">
      {rings && <Rings />}
      <slot />
      <footer class="foot">
        <span>© {new Date().getFullYear()} 李伟宸</span>
        <span>
          <a href="/rss.xml">RSS</a> · <a href="https://github.com/Weichenleeeee123">GitHub</a>
        </span>
      </footer>
    </div>
  </body>
</html>
